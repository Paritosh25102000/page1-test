{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easybim.com/schemas/staging/page3-physical-progress",
  "title": "Page 3 Staging Dataset",
  "description": "Pre-aggregated dataset for Physical Progress (Floor Counts) and Sprint Activity.",
  "type": "object",
  
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "generated_at": { "type": "string" },
        "sprint_window": {
          "type": "object",
          "description": "Context for the Sprint Metrics.",
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        }
      }
    },

    "controls": {
      "type": "object",
      "description": "Uses shared control logic from Page 1 (Hierarchy), no unique controls."
    },

    "dashboard_data": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "floor_performance_table": {
              "type": "array",
              "description": "Recursive structure for Zone -> Region -> Project table (PG3-WIDGET-01).",
              "items": { "$ref": "#/$defs/performance_node" }
            },

            "achievement_matrix_physical": {
              "type": "object",
              "description": "Heatmap data for Sprint Achievement (PG3-WIDGET-02).",
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "type": "string" },
                      "buckets": {
                        "type": "object",
                        "properties": {
                          "gt_120": { "type": "integer" },
                          "100_120": { "type": "integer" },
                          "85_100": { "type": "integer" },
                          "60_85": { "type": "integer" },
                          "lt_60": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            },

            "sprint_leaderboards": {
              "type": "object",
              "description": "Top 5 and Bottom 5 Projects (PG3-WIDGET-03/04).",
              "properties": {
                "top_5": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/project_rank" }
                },
                "bottom_5": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/project_rank" }
                }
              }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "performance_node": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Zone", "Region", "Project"] },
        "metrics": {
          "type": "object",
          "properties": {
            "aop_plan_floors": { "type": "integer" },
            "sprint_plan_floors": { "type": "integer" },
            "actual_floors": { "type": "integer" },
            "pct_aop": { "type": "number" },
            "pct_sprint": { "type": "number" }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/performance_node" }
        }
      },
      "required": ["id", "name", "metrics"]
    },
    "project_rank": {
      "type": "object",
      "properties": {
        "project_name": { "type": "string" },
        "sprint_plan": { "type": "integer" },
        "actual_completed": { "type": "integer" },
        "pct_achieve": { "type": "number" }
      }
    }
  },
  "required": ["meta", "dashboard_data"]
}
